{
  "name": "pi-snipets",
  "version": "0.1.1",
  "description": "Expand loaded Pi prompt templates inline with snipet:<name> and Tab.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/prompt-snippets.ts"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "npm install --save-dev --ignore-scripts @earendil-works/pi-coding-agent@latest @earendil-works/pi-tui@latest && npm run check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:e2e": "python3 tests/e2e.py && SNIPPET_TEST_DEFAULT_EDITOR=1 python3 tests/e2e.py"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
